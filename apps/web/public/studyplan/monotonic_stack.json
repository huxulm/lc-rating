          "summary": "原理讲解：[单调栈【基础算法精讲 26】](https://www.bilibili.com/video/BV1VN411J7S7/)\n\n模板：\n\n```py [sol-Python3]\n# 返回 left，其中 left[i] 是 nums[i] 左侧最近的严格大于 nums[i] 的数的下标，若不存在则为 -1\n# 时间复杂度 O(len(nums))\ndef left_greater(nums: list[int]) -> list[int]:\n    n = len(nums)\n    left = [-1] * n\n    st = []\n    for i, x in enumerate(nums):\n        while st and nums[st[-1]] <= x:  # 如果求严格小于，改成 >=\n            st.pop()\n        if st:\n            left[i] = st[-1]\n        st.append(i)\n    return left\n\n# 返回 right，其中 right[i] 是 nums[i] 右侧最近的严格大于 nums[i] 的数的下标，若不存在则为 len(nums)\n# 时间复杂度 O(len(nums))\ndef right_greater(nums: list[int]) -> list[int]:\n    n = len(nums)\n    right = [n] * n\n    st = []\n    for i in range(n - 1, -1, -1):\n        x = nums[i]\n        while st and nums[st[-1]] <= x:  # 如果求严格小于，改成 >=\n            st.pop()\n        if st:\n            right[i] = st[-1]\n        st.append(i)\n    return right\n```\n\n```java [sol-Java]\nclass Solution {\n    // 返回 left，其中 left[i] 是 nums[i] 左侧最近的严格大于 nums[i] 的数的下标，若不存在则为 -1\n    // 时间复杂度 O(nums.length)\n    private int[] leftGreater(int[] nums) {\n        int n = nums.length;\n        int[] left = new int[n];\n        Deque<Integer> st = new ArrayDeque<>();\n        st.push(-1); // 哨兵\n        for (int i = 0; i < n; i++) {\n            int x = nums[i];\n            while (st.size() > 1 && nums[st.peek()] <= x) { // 如果求严格小于，改成 >=\n                st.pop();\n            }\n            left[i] = st.peek();\n            st.push(i);\n        }\n        return left;\n    }\n\n    // 返回 right，其中 right[i] 是 nums[i] 右侧最近的严格大于 nums[i] 的数的下标，若不存在则为 nums.length\n    // 时间复杂度 O(nums.length)\n    private int[] rightGreater(int[] nums) {\n        int n = nums.length;\n        int[] right = new int[n];\n        Deque<Integer> st = new ArrayDeque<>();\n        st.push(n); // 哨兵\n        for (int i = n - 1; i >= 0; i--) {\n            int x = nums[i];\n            while (st.size() > 1 && nums[st.peek()] <= x) { // 如果求严格小于，改成 >=\n                st.pop();\n            }\n            right[i] = st.peek();\n            st.push(i);\n        }\n        return right;\n    }\n}\n```\n\n```cpp [sol-C++]\n// 返回 left，其中 left[i] 是 nums[i] 左侧最近的严格大于 nums[i] 的数的下标，若不存在则为 -1\n// 时间复杂度 O(nums.size())\nvector<int> left_greater(vector<int>& nums) {\n    int n = nums.size();\n    vector<int> left(n);\n    stack<int> st;\n    st.push(-1); // 哨兵\n    for (int i = 0; i < n; i++) {\n        int x = nums[i];\n        while (st.size() > 1 && nums[st.top()] <= x) { // 如果求严格小于，改成 >=\n            st.pop();\n        }\n        left[i] = st.top();\n        st.push(i);\n    }\n    return left;\n}\n\n// 返回 right，其中 right[i] 是 nums[i] 右侧最近的严格大于 nums[i] 的数的下标，若不存在则为 nums.size()\n// 时间复杂度 O(nums.size())\nvector<int> right_greater(vector<int>& nums) {\n    int n = nums.size();\n    vector<int> right(n);\n    stack<int> st;\n    st.push(n); // 哨兵\n    for (int i = n - 1; i >= 0; i--) {\n        int x = nums[i];\n        while (st.size() > 1 && nums[st.top()] <= x) { // 如果求严格小于，改成 >=\n            st.pop();\n        }\n        right[i] = st.top();\n        st.push(i);\n    }\n    return right;\n}\n```\n\n```go [sol-Go]\n// 返回 left，其中 left[i] 是 nums[i] 左侧最近的严格大于 nums[i] 的数的下标，若不存在则为 -1\n// 时间复杂度 O(len(nums))\nfunc leftGreater(nums []int) []int {\n\tn := len(nums)\n\tleft := make([]int, n)\n\tst := []int{-1} // 哨兵\n\tfor i, x := range nums {\n\t\tfor len(st) > 1 && nums[st[len(st)-1]] <= x { // 如果求严格小于，改成 >=\n\t\t\tst = st[:len(st)-1]\n\t\t}\n\t\tleft[i] = st[len(st)-1]\n\t\tst = append(st, i)\n\t}\n\treturn left\n}\n\n// 返回 right，其中 right[i] 是 nums[i] 右侧最近的严格大于 nums[i] 的数的下标，若不存在则为 len(nums)\n// 时间复杂度 O(len(nums))\nfunc rightGreater(nums []int) []int {\n\tn := len(nums)\n\tright := make([]int, n)\n\tst := []int{n} // 哨兵\n\tfor i := n - 1; i >= 0; i-- {\n\t\tx := nums[i]\n\t\tfor len(st) > 1 && nums[st[len(st)-1]] <= x { // 如果求严格小于，改成 >=\n\t\t\tst = st[:len(st)-1]\n\t\t}\n\t\tright[i] = st[len(st)-1]\n\t\tst = append(st, i)\n\t}\n\treturn right\n}\n```"
